rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Rider document uploads - only the rider themselves can upload/delete
    match /rider_documents/{riderId}/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == riderId;
      allow write: if request.auth != null && request.auth.uid == riderId
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == riderId;
    }
  }
}
